# Copy to .env.local and fill in.
#
# EXPO_PUBLIC_* is the Expo equivalent of NEXT_PUBLIC_*: these are inlined into
# the JS bundle and are readable by anyone with the app, so only publishable
# values belong here.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The secrets that used to live in .env.local for the Next.js API routes do NOT
# belong in this file — there is no server in an Expo app to read them, and
# anything here ships to the device. Set them on the Convex deployment instead:
#
#   npx convex env set LIVEBLOCKS_SECRET_KEY <key>
#   npx convex env set CLERK_SECRET_KEY      <key>
#   npx convex env set GROQ_API_KEY          <key>   # phase 1b
#   npx convex env set GEMINI_API_KEY        <key>   # phase 1b
